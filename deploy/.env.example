# 复制为 deploy/.env 后填写真实值；不得提交到仓库
LOCAL_FULL_ACCESS=true
DATABASE_URL=sqlite:////app/data/app.db
SECRET_KEY=replace-with-a-long-random-string
DATA_DIR=/app/data

# MinerU 官方精准解析（唯一通道）
MINERU_PROVIDER=official
MINERU_API_TOKEN=
MINERU_API_BASE=https://mineru.net/api/v4
MINERU_MODEL_VERSION=pipeline
MINERU_IS_OCR=true
MINERU_ENABLE_TABLE=true
MINERU_ENABLE_FORMULA=false
MINERU_LANGUAGE=ch
MINERU_SPLIT_PAGES=200
MINERU_SPLIT_MB=200
MINERU_KEEP_IMAGES=false
MINERU_MAX_DAILY_PAGES=1000
MINERU_POLL_INTERVAL=10
MINERU_TIMEOUT=1800

# InsightFace 人脸检测（本地运行；模型挂载到 /app/data/models/insightface）
FACE_DETECTION_ENABLED=true
FACE_MODEL_PATH=/app/data/models/insightface/det_10g.onnx
FACE_DETECT_DPI=150
FACE_DET_SIZE=640
FACE_DET_THRESH=0.5
FACE_MIN_SIZE_PT=18
FACE_PAD_RATIO=0.12
FACE_TILE_SIZE=0
FACE_SCAN_MODE=image_pages
FACE_REPLACE_ID_AVATAR=true
FACE_FAIL_POLICY=fail
FACE_CTX_ID=-1
FACE_ORT_THREADS=0

# 蓝色印章 / 社保证明条码检测
BLUE_STAMP_ENABLED=true
BLUE_STAMP_DPI=150
SOCIAL_INSURANCE_ENABLED=true
SOCIAL_INSURANCE_DPI=200

ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
WORKER_ENABLED=true
MAX_UPLOAD_MB=200
CORS_ORIGINS=https://tuomin.bjzcc.cn