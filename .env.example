# 复制为 .env 后按实际环境修改；.env 不得提交到仓库
# 本地部署默认所有登录用户拥有最高权限（可修改规则）；服务器部署改为 false
LOCAL_FULL_ACCESS=true
DATABASE_URL=sqlite:///./data/app.db
SECRET_KEY=please-change-to-a-long-random-string
DATA_DIR=./data

# MinerU 官方精准解析（唯一通道）
MINERU_PROVIDER=official
MINERU_API_TOKEN=
MINERU_API_BASE=https://mineru.net/api/v4
MINERU_MODEL_VERSION=pipeline
MINERU_IS_OCR=true
MINERU_ENABLE_TABLE=true
MINERU_ENABLE_FORMULA=false
MINERU_LANGUAGE=ch
MINERU_SPLIT_PAGES=200
MINERU_SPLIT_MB=200
MINERU_KEEP_IMAGES=false
MINERU_MAX_DAILY_PAGES=1000
MINERU_POLL_INTERVAL=10
MINERU_TIMEOUT=1800

# InsightFace 人脸检测（本地运行；需先下载检测模型）
FACE_DETECTION_ENABLED=true
FACE_MODEL_PATH=./data/models/insightface/det_10g.onnx
FACE_DETECT_DPI=150
FACE_DET_SIZE=640
FACE_DET_THRESH=0.5
FACE_MIN_SIZE_PT=18
FACE_PAD_RATIO=0.12
FACE_TILE_SIZE=0
FACE_SCAN_MODE=image_pages
FACE_REPLACE_ID_AVATAR=true
FACE_FAIL_POLICY=fail
FACE_CTX_ID=-1
FACE_ORT_THREADS=0

# 蓝色印章 / 社保证明条码检测
BLUE_STAMP_ENABLED=true
BLUE_STAMP_DPI=150
SOCIAL_INSURANCE_ENABLED=true
SOCIAL_INSURANCE_DPI=200

ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
WORKER_ENABLED=true
MAX_UPLOAD_MB=200
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173